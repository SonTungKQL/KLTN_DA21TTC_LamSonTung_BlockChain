NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=certificate-blockchain
CLIENT_URL=http://localhost:3001
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Set after `npm run contract:deploy:local`; never commit private keys.
CERTIFICATE_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
# Tùy chọn cho nhiều cơ sở: JSON map mã cơ sở -> private key của issuer.
# BLOCKCHAIN_ISSUER_PRIVATE_KEYS={"TVU":"0x..."}
BLOCKCHAIN_ISSUER_PRIVATE_KEYS=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400
# Enable only when the client encrypts JSON request bodies and decrypts JSON responses.
API_ENCRYPTION_ENABLED=false
API_ENCRYPTION_KEY=replace-with-a-strong-shared-secret
