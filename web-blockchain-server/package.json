{
  "name": "web-blockchain-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "tsx src/scripts/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:unit": "tsx --test src/config/env.test.ts src/blockchain/BlockchainReadClient.test.ts",
    "test:contract": "hardhat test",
    "contract:compile": "hardhat compile",
    "contract:node": "hardhat node",
    "contract:deploy:local": "hardhat run scripts/deploy.ts --network ganache"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "mongoose": "^8.18.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "hardhat": "^2.26.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
